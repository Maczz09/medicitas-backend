NODE_ENV=development

# MySQL
MYSQL_ROOT_PASSWORD=root_secret_medicitas
MYSQL_USER=medicitas_app
MYSQL_PASSWORD=app_secret_medicitas

# Redis
REDIS_PASSWORD=redis_secret_medicitas

# RabbitMQ
RABBITMQ_USER=medicitas_broker
RABBITMQ_PASSWORD=broker_secret_medicitas

# JWT
JWT_SECRET=super_secret_jwt_medicitas_2026
JWT_EXPIRES_IN=8h

# APIs externas (mocks en desarrollo)
# MediCitas corre en Docker → usa host.docker.internal para alcanzar el stack de Aseguradora
# que levanta independientemente en localhost:4001 del host.
# En Windows/Docker Desktop, host.docker.internal apunta automáticamente al host.
USE_MOCK_SEGURO=false
ASEGURADORA_API_URL=http://host.docker.internal:4001/api/v2
ASEGURADORA_API_KEY=prosalud_secret_key_mock
# Fallback de coberturas (cache-aside + reconciliación) — v2.1.0
SEGUROS_FALLBACK_URL=http://seguros_fallback_lb:4010

# Farmacia — Escenario B: ambos stacks en Docker conectados via medicitas_shared_net
# Usar el nombre del servicio como host (resolución DNS interna de Docker)
USE_MOCK_FARMACIA=false
FARMACIA_API_URL=http://farmacia_api:4002/api/v2/farmacia/recepcionar-receta
FARMACIA_API_KEY=farmacia_key_mock

# SMS (gateway genérico de texto plano — SMSAxiosAdapter)
SMS_API_URL=https://api.sms-mock.pe
SMS_API_KEY=sms_key_mock

# Twilio (workers — recordatorios/alertas de tolerancia)
TWILIO_ACCOUNT_SID=twilio_account_sid_mock
TWILIO_AUTH_TOKEN=twilio_auth_token_mock
TWILIO_MESSAGING_SERVICE_SID=twilio_messaging_service_sid_mock

# Resiliencia S2S — horario ÚNICO para TODOS los adaptadores HTTP salientes
# (internos y externos: Pacientes/Citas/Pagos/Coberturas/Documentos/
# Aseguradora/Farmacia). Reemplaza los nombres viejos, dispersos y
# colisionados que existían antes de esta migración:
#   - CB_TIMEOUT_MS / CB_ERROR_THRESHOLD / CB_RESET_TIMEOUT_MS eran, pese al
#     nombre genérico, específicos del CB de Seguros — y por accidente el CB
#     de SMS (smsCBConfig.js) leía las MISMAS variables.
#   - CB_TIMEOUT_MS_FARMACIA tenía su propio sufijo, sin convención común.
#   - RETRY_BASE_MS/RETRY_MAX_MS eran los parámetros del Full Jitter
#     anterior (backoff aleatorio 0..exponencial); con el horario FIJO
#     3s/5s/8s + jitter actual ya no aplican.
# Ver src/shared/resilience/config.js — todos los adaptadores S2S leen ESTAS
# variables una sola vez, sin duplicación por servicio.
#
# NOTA — efecto colateral en SMS (SMSAxiosAdapter): ese adaptador NO forma
# parte de esta migración (está huérfano — ningún flujo vivo lo instancia;
# el canal real de notificaciones es WhatsApp, WhatsappWebJSAdapter). Su
# propio Circuit Breaker (smsCBConfig.js) leía por accidente las variables
# viejas de Seguros; ahora que tienen nombres nuevos, smsCBConfig.js cae a
# sus propios defaults hardcodeados. Sin impacto observable: código
# inalcanzable, decisión consciente, no un descuido.
RETRY_SCHEDULE_MS=3000,5000,8000
RETRY_JITTER_MS=200
TIMEOUT_SCHEDULE_MS=2000,4000,8000
# CB_TIMEOUT_MS debe ser MAYOR que el último valor de TIMEOUT_SCHEDULE_MS
# (margen de 500ms, mismo criterio que antes: HTTP_TIMEOUT_MS=3000 <
# CB_TIMEOUT_MS=3500). Es el timeout INTERNO de opossum por llamada — no
# confundir con TIMEOUT_SCHEDULE_MS (el de axios, por intento).
CB_TIMEOUT_MS=8500
CB_ERROR_THRESHOLD_PERCENTAGE=50
CB_RESET_TIMEOUT_MS=30000
CB_VOLUME_THRESHOLD=5
CB_ROLLING_COUNT_TIMEOUT_MS=10000
CB_ROLLING_COUNT_BUCKETS=10
BULKHEAD_MAX_SOCKETS=20

# Reintento ante deadlock de MySQL (1213/ER_LOCK_DEADLOCK) en transacciones de
# Citas (Reservar/Reprogramar) — src/shared/resilience/retryOnDeadlock.js.
# NO confundir con RETRY_SCHEDULE_MS de arriba: ese es solo para llamadas S2S
# HTTP. Un deadlock ya se resolvió al detectarse, así que el horario es en
# milisegundos, no segundos.
DEADLOCK_RETRY_SCHEDULE_MS=25,75,150
DEADLOCK_RETRY_JITTER_MS=20

# Configuración de Correo (Nodemailer) para OTP
# EMAIL_PASS es una contraseña de aplicación de Gmail (16 caracteres), no la
# contraseña normal de la cuenta — se genera en myaccount.google.com/apppasswords
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_app_password_de_16_caracteres

# Token Interno para comunicación Servicio-a-Servicio
INTERNAL_SERVICE_TOKEN=internal_service_super_secret_token_2026
# Usada por TODOS los adaptadores S2S internos (antes, Seguros tenía su
# propia PACIENTES_API_URL con una forma distinta — URL completa hasta el
# recurso, en vez de origen bare — ya unificada a esta). Dentro del
# contenedor la app se alcanza a sí misma en localhost:3000 (Nginx/80 vive
# en otro contenedor).
APP_INTERNAL_BASE_URL=http://localhost:3000

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=medicitas_grafana_2026

# Rate limiting (requests por 15 min)
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=20

# ─── Pruebas de carga (normalmente NO se tocan aquí) ───────────────────────
# Estas variables las activa docker-compose.loadtest.yml. En producción se
# dejan como abajo (o ausentes) y el sistema se comporta igual que siempre.
#   LOAD_TEST_MODE=true  → apaga el rate limiting para que k6 no choque con él.
#   CLUSTER_MODE=true    → arranca N procesos Node (fork por core) en vez de 1.
#   WEB_CONCURRENCY      → nº de workers del cluster (vacío = os.cpus().length).
#   DB_POOL_SIZE         → conexiones del pool de MySQL por worker (default 10).
LOAD_TEST_MODE=false
CLUSTER_MODE=false
WEB_CONCURRENCY=
DB_POOL_SIZE=10
# Log de acceso por petición (cada request → una línea en Loki con método, ruta,
# status, duración y correlationId). ON por defecto; se apaga solo en modo carga
# para no inundar Loki. Forzar con LOG_HTTP=true/false.
LOG_HTTP=
